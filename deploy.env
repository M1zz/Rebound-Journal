# DeployBar 배포 설정 — 모찌모
#
# 이 파일이 없으면 DeployBar 가 폴더 이름으로 scheme 을 추측한다.
# 값은 따옴표 없이, 키 이름은 그대로 둔다.

# Xcode scheme 이름. `xcodebuild -list` 의 Schemes 와 정확히 같아야 한다.
# 위젯 확장(MochimoWidget)은 앱 scheme 이 함께 빌드하므로 여기 적지 않는다.
SCHEME=Mochimo

# 배포 플랫폼: ios | macos
PLATFORM=ios

# 버전을 담은 xcconfig. DeployBar 가 버전을 올릴 때 이 파일만 고친다.
# (전에는 project.pbxproj 를 직접 고쳤다 — 타깃이 둘이라 어긋날 위험이 있었다)
VERSION_XCCONFIG=Config/Version.xcconfig

# 배포 직전에 돌릴 검사. 0 이 아닌 값으로 끝나면 배포가 멈춘다.
PREDEPLOY_SCRIPT=scripts/predeploy.sh

# App Store 에 등록한 언어. 기본 언어는 영어라 맨 앞에 둔다. 릴리즈노트를 만들 언어이자 번역 검사 기준이다.
# 여기 없는 언어는 RELEASE_NOTES.md 에 절이 있어도 올라가지 않는다.
LOCALES=en,ko,en-GB,zh-Hans,zh-Hant,ja,ru,es,de,fr,it,pt-BR,th,vi,cs,da,el,fi,id,nb,nl,pl,sv,tr

# 배포 전 검사. 다른 앱과 같게 번역 빠짐·릴리즈노트 빠짐이 있으면 멈춘다.
LOCALIZATION_GATE=strict
RELEASE_NOTES_GATE=strict
