    "누르면 모찌가 바로 귀 기울여요. 자판 없이 말로 오늘을 남겨요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte a váš mochi kamarád začne hned poslouchat. Povězte o svém dni nahlas, bez psaní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk, så lytter din mochi-ven med det samme. Fortæl om din dag uden at skrive."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen, und dein Mochi-Freund hört sofort zu. Erzähl von deinem Tag, ganz ohne Tippen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε και ο φίλος σας mochi αρχίζει αμέσως να ακούει. Πείτε φωναχτά πώς πήγε η μέρα σας, χωρίς πληκτρολόγηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap and your mochi friend listens right away. Share your day out loud, no typing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap and your mochi friend listens straight away. Share your day out loud, no typing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca y tu amigo mochi te escucha al instante. Cuenta tu día en voz alta, sin escribir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta, niin mochi-kaverisi kuuntelee heti. Kerro päivästäsi ääneen, ilman kirjoittamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez et votre ami mochi vous écoute tout de suite. Racontez votre journée à voix haute, sans clavier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk, teman mochi langsung mendengarkan. Ceritakan harimu dengan suara, tanpa mengetik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e il tuo amico mochi ti ascolta subito. Racconta la tua giornata a voce, senza scrivere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップすると、ともだちがすぐに耳を傾けます。文字を打たずに、声で今日を記録できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누르면 모찌가 바로 귀 기울여요. 자판 없이 말로 오늘을 남겨요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk, så lytter mochi-vennen din med en gang. Fortell om dagen din uten å skrive."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik en je mochi-vriendje luistert meteen. Vertel over je dag, zonder te typen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij, a Twój przyjaciel mochi od razu zacznie słuchać. Opowiedz o swoim dniu na głos, bez pisania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e seu amigo mochi já começa a ouvir. Conte seu dia em voz alta, sem digitar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите, и друг-моти сразу начнёт слушать. Расскажите о своём дне вслух, без набора текста."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck så lyssnar din mochi-kompis direkt. Berätta om din dag högt, utan att skriva."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะแล้วเพื่อนโมจิจะฟังทันที เล่าวันของคุณด้วยเสียง ไม่ต้องพิมพ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokunun, mochi arkadaşınız hemen dinlemeye başlasın. Gününüzü yazmadan, sesli anlatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm là bạn mochi lắng nghe ngay. Kể về ngày của bạn bằng giọng nói, không cần gõ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点一下，麻薯小伙伴马上听你说。不用打字，说说今天就好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下，麻糬夥伴馬上聽你說。不用打字，說說今天就好。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
