    "무료로 쓰던 건 그대로, 몇 가지가 더 열려요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything free stays free. A few more things open up."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co bylo zdarma, zůstává zdarma, a odemknou se další věci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, der var gratis, forbliver gratis, og der bliver låst lidt mere op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was kostenlos war, bleibt es – und einiges kommt dazu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ό,τι ήταν δωρεάν παραμένει δωρεάν και ξεκλειδώνουν και μερικά ακόμη."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything free stays free. A few more things open up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo gratuito sigue igual, y se desbloquean algunas cosas más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmaiseksi käyttämäsi pysyy ennallaan, ja lisää avautuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui était gratuit le reste, et d’autres choses s’ajoutent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang gratis tetap gratis, dan beberapa hal lagi terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che era gratuito resta tale, e se ne sblocca dell’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料で使えていたものはそのまま、いくつかが新しく使えるようになります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som var gratis, forblir gratis, og litt til låses opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat gratis was, blijft gratis, en er komt nog wat bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co było darmowe, takie zostaje, a odblokuje się coś jeszcze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que já era grátis continua grátis, e mais algumas coisas são liberadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё бесплатное остаётся, а кое-что добавится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som var gratis förblir gratis, och lite mer låses upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่ใช้ฟรีอยู่ยังคงเหมือนเดิม และมีอีกหลายอย่างให้ปลดล็อก"
