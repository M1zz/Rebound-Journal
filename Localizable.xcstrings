        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On met le reste de côté et on ne regarde que ça."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kita simpan dulu yang lain dan lihat ini saja."
