    "'지나온 길'에서 목표 하나를 내려놓으면 새로 적을 수 있어요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pusťte jeden cíl v části „Ušlá cesta“ a můžete zapsat nový."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slip ét mål under „Vejen hidtil“, så kan du skrive et nyt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass unter „Zurückgelegter Weg“ ein Ziel los, dann kannst du ein neues anlegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφήστε έναν στόχο στο «Διαδρομή που έχετε διανύσει» και θα μπορείτε να γράψετε νέο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set one goal down in 'The way you've come,' and you can write a new one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set one goal down in 'The way you've come,' and you can write a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelta una meta en «Camino recorrido» y podrás escribir otra nueva."
          }
        },
        "fi" : {
          "stringUnit" : {
