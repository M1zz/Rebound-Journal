        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym urządzeniu funkcja porządkowania jest niedostępna. Zapiszę tak, jak usłyszę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste dispositivo, a organização não está disponível. Vou anotar do jeito que ouvi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве функция упорядочивания недоступна. Запишу как услышал."
