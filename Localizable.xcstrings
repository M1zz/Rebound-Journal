    "'지나온 길'에서 목표 하나를 내려놓으면 새로 적을 수 있어요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass unter „Zurückgelegter Weg“ ein Ziel los, dann kannst du ein neues anlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set one goal down in 'The way you've come,' and you can write a new one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set one goal down in 'The way you've come,' and you can write a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelta una meta en «Camino recorrido» y podrás escribir otra nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lâchez un objectif dans « Chemin parcouru » pour pouvoir en écrire un nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「歩いた道」で目標をひとつ手放すと、新しく書けます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отпустите одну цель в разделе «Пройденный путь» — и можно будет записать новую."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「走过的路」里放下一个目标，就可以写新的目标了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「走過的路」裡放下一個目標，就可以寫新的目標了。"
          }
        }
      }
    },
