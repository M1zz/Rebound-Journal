    "나머지는 서두르지 않아도 돼요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S ostatním není kam spěchat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resten haster ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den Rest musst du dich nicht beeilen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα υπόλοιπα δεν βιάζονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to hurry the rest."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to hurry the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo demás no corre prisa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muilla ei ole kiire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le reste n’est pas pressé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisanya tidak perlu buru-buru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per il resto non c’è fretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残りは急がなくて大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나머지는 서두르지 않아도 돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resten haster ikke."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O resto não tem pressa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С остальным можно не спешить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่เหลือไม่ต้องรีบนะ"
