    "'지나온 길'에서 목표 하나를 내려놓으면 새로 적을 수 있어요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass unter „Zurückgelegter Weg“ ein Ziel los, dann kannst du ein neues anlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set one goal down in 'The way you've come,' and you can write a new one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set one goal down in 'The way you've come,' and you can write a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelta una meta en «Camino recorrido» y podrás escribir otra nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lâchez un objectif dans « Chemin parcouru » pour pouvoir en écrire un nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia andare un obiettivo in «Strada percorsa» e potrai scriverne uno nuovo."
          }
        },
