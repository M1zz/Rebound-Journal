    "그럼 '%@'%@ 향해서,\n내일 바로 해낼 수 있을 만큼 작은 일 하나는 뭘까?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Und was wäre auf dem Weg zu „%1$@“%2$@ eine Sache, die so klein ist, dass du sie gleich morgen schaffst?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So, toward '%1$@' —\nwhat is one thing small enough to finish tomorrow?%2$@"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So, toward '%1$@' —\nwhat is one thing small enough to finish tomorrow?%2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entonces, rumbo a «%1$@»%2$@ ¿qué cosa tan pequeña podrías hacer mañana mismo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alors, pour avancer vers « %1$@ »%2$@ quelle chose assez petite pourrais-tu faire dès demain ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それじゃあ「%1$@」%2$@ 目指して、\n明日すぐにできるくらい小さなことをひとつ挙げるなら、何だろう？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그럼 '%1$@'%2$@ 향해서,\n내일 바로 해낼 수 있을 만큼 작은 일 하나는 뭘까?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тогда на пути к «%1$@»%2$@ какое одно дело настолько мало, что его можно сделать уже завтра?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那么，朝着「%1$@」，\n有什么小到明天就能做完的一件事？%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那麼，朝著「%1$@」，\n有什麼小到明天就能做完的一件事？%2$@"
          }
        }
      }
    },
