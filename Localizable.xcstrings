        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kita berhenti di sini untuk hari ini.\nTidak perlu memaksakan jawaban sekarang.\nSudah tersimpan, lain kali kita lihat bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
