        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้หยุดแค่นี้ก่อนนะ\nตอนนี้ไม่ต้องฝืนหาคำตอบ\nบันทึกไว้แล้ว ไว้ดูด้วยกันคราวหน้า"
