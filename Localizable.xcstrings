        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그럼 '%1$@'%2$@ 향해서,\n내일 바로 해낼 수 있을 만큼 작은 일 하나는 뭘까?"
          }
        }
      }
    },
    "그럼 '%@'%@ 향해서,\n내일 바로 해낼 수 있을 만큼 작은 일 하나는 뭘까요?": {
