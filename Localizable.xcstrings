    "목표를 제한 없이 적고, 조약돌을 고르고, 기록을 파일로 간직해요. 한 번 사면 계속 써요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisujte cíle bez omezení, vybírejte oblázky a ukládejte záznamy do souboru. Jednou koupíte, navždy používáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv mål ned uden grænse, vælg din sten, og gem dine noter i en fil. Køb én gang, brug for altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziele ohne Limit notieren, Kiesel auswählen und Einträge als Datei sichern. Einmal kaufen, immer nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σημειώστε στόχους χωρίς όριο, επιλέξτε βότσαλο και κρατήστε τις σημειώσεις σε αρχείο. Μία αγορά, για πάντα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep unlimited goals, choose your pebble, and export your records. Buy once, keep it for good."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep unlimited goals, choose your pebble, and export your records. Buy once, keep it for good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota metas sin límite, elige tu guijarro y guarda tus registros en un archivo. Se compra una vez y se usa siempre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaa tavoitteita rajoituksetta, valitse kivesi ja säilytä merkinnät tiedostossa. Osta kerran, käytä aina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez des objectifs sans limite, choisissez votre galet et conservez vos notes dans un fichier. Un seul achat, pour toujours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat tujuan tanpa batas, pilih kerikil, dan simpan catatan sebagai berkas. Beli sekali, pakai selamanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annota obiettivi senza limiti, scegli il tuo sassolino e conserva le note in un file. Si compra una volta e si usa per sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標を無制限に書き、小石を選び、記録をファイルに残せます。一度買えば、ずっと使えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ned mål uten grense, velg steinen din og ta vare på notatene i en fil. Kjøp én gang, bruk for alltid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote metas sem limite, escolha sua pedrinha e guarde seus registros em um arquivo. Compre uma vez e use sempre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте цели без ограничений, выбирайте камешки и сохраняйте записи в файл. Одна покупка — навсегда."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดเป้าหมายได้ไม่จำกัด เลือกก้อนหิน และเก็บบันทึกเป็นไฟล์ ซื้อครั้งเดียวใช้ได้ตลอด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi mục tiêu không giới hạn, chọn viên đá và lưu ghi chép thành tệp. Mua một lần, dùng mãi mãi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不限数量地写下目标，挑选小石子，把记录保存成文件。一次购买，长久使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不限數量地寫下目標，挑選小石子，把記錄儲存成檔案。一次購買，長久使用。"
          }
        }
      }
    },
    "목표와 남긴 기록이 모두 사라지고 되돌릴 수 없어요. iCloud로 이어진 다른 기기에서도 지워져요. 설정과 구매는 그대로 남아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny vaše cíle a záznamy zmizí a nelze je obnovit. Smažou se i na dalších zařízeních propojených přes iCloud. Nastavení a nákupy zůstanou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle dine mål og noter forsvinder og kan ikke gendannes. De slettes også på dine andre enheder, der er forbundet via iCloud. Indstillinger og køb bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Ziele und Einträge verschwinden und lassen sich nicht wiederherstellen. Auch auf anderen Geräten mit iCloud werden sie gelöscht. Einstellungen und Käufe bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλοι οι στόχοι και οι σημειώσεις σας θα χαθούν και δεν θα μπορούν να ανακτηθούν. Θα διαγραφούν και από τις άλλες συσκευές που συνδέονται μέσω iCloud. Οι ρυθμίσεις και οι αγορές διατηρούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your goals and records will be gone, and this can't be undone. They'll also be removed from your other devices through iCloud. Your settings and purchase stay."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your goals and records will be gone, and this can't be undone. They'll also be removed from your other devices through iCloud. Your settings and purchase stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas tus metas y registros desaparecerán y no se podrán recuperar. También se borrarán en tus otros dispositivos conectados con iCloud. Los ajustes y las compras se conservan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki tavoitteesi ja merkintäsi katoavat, eikä niitä voi palauttaa. Ne poistuvat myös muilta iCloudilla yhdistetyiltä laitteilta. Asetukset ja ostokset säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous vos objectifs et notes disparaîtront et ne pourront pas être restaurés. Ils seront aussi supprimés sur vos autres appareils reliés par iCloud. Les réglages et les achats sont conservés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua tujuan dan catatan Anda akan hilang dan tidak dapat dipulihkan. Di perangkat lain yang terhubung lewat iCloud juga akan terhapus. Pengaturan dan pembelian tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i tuoi obiettivi e le tue note spariranno e non potranno essere recuperati. Verranno eliminati anche sugli altri dispositivi collegati tramite iCloud. Impostazioni e acquisti restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標も記録もすべて消えて、元に戻せません。iCloudでつながっている他のデバイスからも消えます。設定と購入はそのまま残ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle målene og notatene dine forsvinner og kan ikke gjenopprettes. De slettes også på andre enheter koblet til via iCloud. Innstillinger og kjøp beholdes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as suas metas e registros serão apagados e não poderão ser recuperados. Também serão removidos dos outros dispositivos conectados pelo iCloud. Ajustes e compras permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все цели и записи исчезнут без возможности восстановления. На других устройствах с iCloud они тоже будут удалены. Настройки и покупки сохранятся."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป้าหมายและบันทึกทั้งหมดจะหายไปและกู้คืนไม่ได้ อุปกรณ์อื่นที่เชื่อมต่อด้วย iCloud ก็จะถูกลบด้วย การตั้งค่าและการซื้อจะยังอยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toàn bộ mục tiêu và ghi chép sẽ biến mất và không thể khôi phục. Trên các thiết bị khác kết nối bằng iCloud cũng sẽ bị xóa. Cài đặt và giao dịch mua vẫn được giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的所有目标和记录都会消失，并且无法恢复。通过 iCloud 同步的其他设备上的内容也会被删除。设置和购买记录会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的所有目標和記錄都會消失，並且無法恢復。透過 iCloud 同步的其他裝置上的內容也會被刪除。設定和購買記錄會保留。"
          }
        }
      }
    },
