    "상황은 알겠어요. 그래서 지금 어떤 기분이에요?" : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situaci chápu. A jak se cítíte teď?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg forstår situationen. Men hvordan har du det nu?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Situation habe ich verstanden. Wie fühlst du dich jetzt?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατάλαβα την κατάσταση. Και πώς νιώθετε τώρα;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I see the situation. So how are you feeling?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I see the situation. So how are you feeling?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendo la situación. ¿Y cómo te sientes ahora?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilanne on selvä. Miltä sinusta tuntuu nyt?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai compris la situation. Et comment vous sentez-vous maintenant ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya mengerti keadaannya. Lalu bagaimana perasaan Anda sekarang?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La situazione mi è chiara. E ora come ti senti?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状況はわかりました。それで、今の気分はどうですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상황은 알겠어요. 그래서 지금 어떤 기분이에요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg forstår situasjonen. Hvordan har du det nå?"
          }
        },
