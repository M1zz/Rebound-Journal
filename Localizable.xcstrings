    "그럼 '%@'%@ 향해서,\n내일 바로 해낼 수 있을 만큼 작은 일 하나는 뭘까?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak co je na cestě k „%1$@“%2$@ jedna malá věc, kterou zvládneš už zítra?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken ene lille ting på vejen mod „%1$@“%2$@ kan du nå allerede i morgen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Und was wäre auf dem Weg zu „%1$@“%2$@ eine Sache, die so klein ist, dass du sie gleich morgen schaffst?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τότε, προς το «%1$@»%2$@ ποιο είναι ένα τόσο μικρό πράγμα που μπορείς να κάνεις ήδη αύριο;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So, toward '%1$@' —\nwhat is one thing small enough to finish tomorrow?%2$@"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So, toward '%1$@' —\nwhat is one thing small enough to finish tomorrow?%2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entonces, rumbo a «%1$@»%2$@ ¿qué cosa tan pequeña podrías hacer mañana mismo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikä olisi sitten matkalla kohti ”%1$@”%2$@ yksi niin pieni asia, että ehdit tehdä sen jo huomenna?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alors, pour avancer vers « %1$@ »%2$@ quelle chose assez petite pourrais-tu faire dès demain ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau begitu, menuju «%1$@»%2$@ apa satu hal kecil yang bisa kamu lakukan besok juga?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allora, verso «%1$@»%2$@ quale piccola cosa potresti fare già domani?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それじゃあ「%1$@」%2$@ 目指して、\n明日すぐにできるくらい小さなことをひとつ挙げるなら、何だろう？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그럼 '%1$@'%2$@ 향해서,\n내일 바로 해낼 수 있을 만큼 작은 일 하나는 뭘까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva er da én liten ting på veien mot «%1$@»%2$@ som du kan klare allerede i morgen?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Então, rumo a «%1$@»%2$@ qual seria uma coisa pequena o bastante pra você fazer já amanhã?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тогда на пути к «%1$@»%2$@ какое одно дело настолько мало, что его можно сделать уже завтра?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
