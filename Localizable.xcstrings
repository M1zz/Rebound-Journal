    "목표를 원하는 만큼" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As many goals as you like"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As many goals as you like"
          }
        },
        "ja" : {
          "stringUnit" : {
