    "앱을 연 날, 대화를 끝낸 날, 목표를 만든 것 같은 행동의 종류, 기록과 목표의 개수, 구매 화면을 본 것만 보냅니다. 적으신 내용은 한 글자도 나가지 않고, 누가 보냈는지는 이 기기에서 만든 무작위 번호로만 구분합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the days you opened the app or finished a conversation, the kinds of actions you took (like creating a goal), how many records and goals you have, and whether you saw the purchase screen are sent. Nothing you write ever leaves, and senders are told apart only by a random number made on this device."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odesílají se jen dny, kdy jste aplikaci otevřeli nebo ukončili rozhovor, druh akcí (třeba vytvoření cíle), počet záznamů a cílů a to, zda jste zobrazili obrazovku nákupu. Z toho, co píšete, neodchází ani písmeno a odesílatel se rozlišuje jen náhodným číslem vytvořeným na tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der sendes kun de dage, hvor du åbnede appen eller afsluttede en samtale, hvilken slags handlinger der er tale om (fx at oprette et mål), antallet af noter og mål og om du har set købsskærmen. Ikke et eneste bogstav af det, du skriver, forlader din enhed, og afsenderen skelnes kun ved et tilfældigt nummer, der er oprettet på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesendet werden nur die Tage, an denen du die App geöffnet oder ein Gespräch beendet hast, die Art von Aktionen wie „Ziel angelegt“, die Anzahl von Einträgen und Zielen und ob du den Kaufbildschirm gesehen hast. Von dem, was du schreibst, verlässt kein einziges Zeichen dein Gerät, und wer sendet, wird nur über eine zufällige, auf diesem Gerät erzeugte Nummer unterschieden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στέλνονται μόνο οι ημέρες που ανοίξατε την εφαρμογή ή ολοκληρώσατε μια συζήτηση, το είδος των ενεργειών (π.χ. δημιουργία στόχου), ο αριθμός σημειώσεων και στόχων και αν είδατε την οθόνη αγοράς. Ούτε ένα γράμμα απ' όσα γράφετε δεν φεύγει, και ο αποστολέας διακρίνεται μόνο από έναν τυχαίο αριθμό που δημιουργήθηκε σε αυτή τη συσκευή."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the days you opened the app or finished a conversation, the kinds of actions you took (like creating a goal), how many records and goals you have, and whether you saw the purchase screen are sent. Nothing you write ever leaves, and senders are told apart only by a random number made on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se envían los días en que abriste la app o terminaste una conversación, el tipo de acciones (como crear una meta), el número de registros y metas, y si viste la pantalla de compra. Nada de lo que escribes sale de tu dispositivo, y quien envía se distingue solo por un número aleatorio creado en este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetetään vain päivät, jolloin avasit sovelluksen tai lopetit keskustelun, toimintojen tyyppi (esim. tavoitteen luominen), merkintöjen ja tavoitteiden määrä sekä se, näitkö ostonäkymän. Kirjoittamastasi ei lähde yhtäkään kirjainta, ja lähettäjä erotetaan vain tällä laitteella luodusta satunnaisluvusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls sont envoyés les jours où vous avez ouvert l’app ou terminé une conversation, le type d’actions comme la création d’un objectif, le nombre de notes et d’objectifs, et si vous avez consulté l’écran d’achat. Pas un seul mot de ce que vous écrivez ne sort, et l’expéditeur n’est distingué que par un numéro aléatoire créé sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang dikirim hanya hari saat Anda membuka app atau mengakhiri percakapan, jenis tindakan seperti membuat tujuan, jumlah catatan dan tujuan, serta apakah Anda melihat layar pembelian. Tak satu huruf pun dari tulisan Anda keluar, dan pengirim hanya dibedakan lewat nomor acak yang dibuat di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono inviati solo i giorni in cui hai aperto l’app o concluso una conversazione, il tipo di azioni come la creazione di un obiettivo, il numero di note e obiettivi e se hai visto la schermata di acquisto. Di ciò che scrivi non esce nemmeno una lettera, e chi invia è distinto solo da un numero casuale creato su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信するのは、アプリを開いた日、会話を終えた日、目標をつくるといった操作の種類、記録と目標の数、購入画面を見たかどうかだけです。書いた内容は一文字も外に出ません。送信者は、このデバイスで作られたランダムな番号でしか区別されません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som sendes, er bare dagene du åpnet appen eller avsluttet en samtale, hva slags handlinger det er snakk om (for eksempel å opprette et mål), antall notater og mål, og om du har sett kjøpsskjermen. Ikke en eneste bokstav av det du skriver, forlater enheten, og avsenderen skilles bare ut med et tilfeldig nummer som er laget på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er worden alleen de dagen verstuurd waarop u de app opende of een gesprek afrondde, het soort acties (zoals een doel aanmaken), het aantal notities en doelen en of u het aankoopscherm hebt gezien. Geen enkele letter van wat u schrijft verlaat het apparaat, en de verzender wordt alleen onderscheiden met een willekeurig nummer dat op dit apparaat is gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłane są tylko dni, w których otwarto aplikację lub zakończono rozmowę, rodzaje działań (np. utworzenie celu), liczba wpisów i celów oraz informacja, czy wyświetlono ekran zakupu. Z tego, co piszesz, nie wychodzi ani jedna litera, a nadawca jest rozróżniany jedynie po losowym numerze utworzonym na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São enviados apenas os dias em que você abriu o app ou terminou uma conversa, o tipo de ação (como criar uma meta), o número de registros e metas e se você viu a tela de compra. Nada do que você escreve sai do aparelho, e quem envia é distinguido apenas por um número aleatório criado neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляются только даты, когда вы открывали приложение или завершали разговор, типы действий (например, создание цели), количество записей и целей и факт просмотра экрана покупки. Ни одного слова из написанного вами не уходит наружу, а отправитель определяется только случайным номером, созданным на этом устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som skickas är bara de dagar du öppnade appen eller avslutade ett samtal, vilken sorts handlingar det rör sig om (till exempel att skapa ett mål), antalet anteckningar och mål samt om du har sett köpskärmen. Inte en enda bokstav av det du skriver lämnar enheten, och avsändaren skiljs bara åt med ett slumpmässigt nummer som skapats på den här enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะส่งเฉพาะวันที่เปิดแอปหรือจบบทสนทนา ประเภทของการกระทำ เช่น การสร้างเป้าหมาย จำนวนบันทึกและเป้าหมาย และว่าเคยเห็นหน้าจอการซื้อหรือไม่ สิ่งที่คุณเขียนจะไม่ถูกส่งออกไปแม้แต่ตัวอักษรเดียว และผู้ส่งจะแยกแยะได้ด้วยหมายเลขสุ่มที่สร้างบนอุปกรณ์เครื่องนี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca uygulamayı açtığınız veya bir sohbeti bitirdiğiniz günler, hedef oluşturma gibi eylem türleri, not ve hedef sayısı ve satın alma ekranını görüp görmediğiniz gönderilir. Yazdıklarınızın tek bir harfi bile dışarı çıkmaz; gönderen yalnızca bu cihazda oluşturulan rastgele bir numarayla ayırt edilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ gửi những ngày bạn mở ứng dụng hoặc kết thúc cuộc trò chuyện, loại thao tác như tạo mục tiêu, số lượng ghi chép và mục tiêu, và việc bạn có xem màn hình mua hay không. Nội dung bạn viết không rời thiết bị dù chỉ một chữ, và người gửi chỉ được phân biệt bằng một số ngẫu nhiên tạo ra trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会发送你打开 App 或结束对话的日期、创建目标等操作的类型、记录和目标的数量，以及是否查看过购买页面。你写下的内容一个字都不会外传，发送者仅通过在本设备上生成的随机编号来区分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會傳送你開啟 App 或結束對話的日期、建立目標等操作的型別、記錄和目標的數量，以及是否檢視過購買頁面。你寫下的內容一個字都不會外傳，傳送者僅透過在本裝置上生成的隨機編號來區分。"
          }
        }
      }
    },
    "야식 참기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No late-night snacks"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "야식 참기"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejíst v noci"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade være med natmad"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachts nichts essen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να μη τρώω τη νύχτα"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No late-night snacks"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No picar de noche"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei yösyöntiä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne pas grignoter la nuit"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menahan makan tengah malam"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resistere agli spuntini notturni"
          }
        },
        "ja" : {
          "stringUnit" : {
