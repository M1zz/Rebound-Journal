    "요즘 하려는 일이 잘 되는지, 제가 가끔 먼저 물어볼게요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every now and then, I'll check in on how things are going."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every now and then, I'll check in on how things are going."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近想做的事顺不顺利，我会偶尔先来问问你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近想做的事順不順利，我會偶爾先來問問你。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近やろうとしていることがうまくいっているか、ときどき私から聞きますね。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время от времени я сам буду спрашивать, как идут ваши дела."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vez en cuando te preguntaré cómo te va."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab und zu frage ich mal nach, wie es bei dir läuft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De temps en temps, je viendrai te demander comment ça avance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni tanto ti chiederò io come vanno le cose."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vez em quando, vou perguntar como as coisas estão indo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บางครั้งเราจะถามก่อนนะว่าเรื่องที่ตั้งใจทำช่วงนี้เป็นไปได้ดีไหม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thỉnh thoảng mình sẽ hỏi trước xem việc bạn đang cố gắng dạo này có suôn sẻ không nhé."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Občas se sám zeptám, jak vám to jde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gang imellem spørger jeg selv, hvordan det går med det, du er i gang med."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πού και πού θα σας ρωτάω εγώ πώς πάνε τα πράγματα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysyn välillä itse, miten suunnitelmasi sujuvat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesekali saya akan bertanya duluan bagaimana kabarnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nå og da spør jeg selv hvordan det går med det du holder på med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Af en toe vraag ik zelf even hoe het gaat met wat je van plan bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od czasu do czasu sam zapytam, jak Ci idzie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Då och då frågar jag själv hur det går med det du håller på med."
