            "value" : "Dnes jsem prostě jen s vámi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag er jeg bare ved din side."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute bin ich einfach nur bei dir."
          }
        },
        "el" : {
          "stringUnit" : {
