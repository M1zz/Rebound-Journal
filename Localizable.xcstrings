    "하나는 있었던 일이고, 하나는 지금 마음이에요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das eine ist, was passiert ist, das andere, wie dir jetzt zumute ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One is what happened. The other is how you feel."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One is what happened. The other is how you feel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cosa es lo que pasó y otra, cómo te sientes ahora."
