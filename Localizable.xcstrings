    "딱히 할 말은 없어요. 그냥 여기 있어요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není moc co říct. Jsem tu prostě s vámi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke så meget at sige. Jeg er bare her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt nicht viel zu sagen. Ich bin einfach hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχω πολλά να πω. Απλώς είμαι εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing much to say. I'm just here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing much to say. I'm just here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay mucho que decir. Solo estoy aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei ole paljon sanottavaa. Olen vain tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de particulier à dire. Je suis juste là."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak banyak yang ingin dikatakan. Saya hanya di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c’è molto da dire. Sono semplicemente qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特に言うことはありません。ただここにいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "딱히 할 말은 없어요. 그냥 여기 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er ikke så mye å si. Jeg er bare her."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tenho muito a dizer. Só estou aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Особо нечего сказать. Я просто рядом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีอะไรจะพูดมากนัก แค่อยู่ตรงนี้"
