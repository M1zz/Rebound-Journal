      }
    },
    "무엇에 닿았고 무엇이 막혔는지, 제가 먼저 보고 말을 걸게요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich sehe zuerst nach, was du erreicht hast und was dich aufgehalten hat, und spreche dich dann an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll watch what you reach and what gets stuck, and I'll speak first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll watch what you reach and what gets stuck, and I'll speak first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veré hasta dónde llegaste y qué te frenó, y te hablaré yo primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je regarde d’abord où vous en êtes arrivé et ce qui vous a retenu, puis je vous parle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarderò io per primo dove sei arrivato e cosa ti ha ostacolato, e poi ti parlerò."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何にたどり着き、何が引っかかったのか、まず私から声をかけますね。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇에 닿았고 무엇이 막혔는지, 제가 먼저 보고 말을 걸게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vou ver até onde você chegou e o que travou, e puxo a conversa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я сам загляну, до чего вы дошли и что вас остановило, и начну разговор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我会留意你走到了哪里、被什么卡住了，并主动和你说话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我會留意你走到了哪裡、被什麼卡住了，並主動和你說話。"
          }
        }
      }
    },
    "무엇을 향해 가고 있는지 아직 못 들었어요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich weiß noch nicht, worauf du zusteuerst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I haven't heard what you're heading toward yet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I haven't heard what you're heading toward yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no sé hacia dónde vas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne sais pas encore vers quoi vous allez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non so ancora verso cosa stai andando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何を目指しているのか、まだ聞いていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇을 향해 가고 있는지 아직 못 들었어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não sei para onde você está indo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я ещё не знаю, к чему вы идёте."
