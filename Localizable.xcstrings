    "개울가에서 주운 듯한 돌 다섯 가지가 더 열려요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five more stones open up, like ones picked up by the stream."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odemkne se dalších pět kamenů, jako by je někdo posbíral u potoka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fem sten mere bliver låst op, som var de samlet op ved bækken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünf weitere Steine werden frei, wie am Bachufer aufgelesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκλειδώνουν άλλες πέντε πέτρες, σαν να τις μάζεψες δίπλα στο ρυάκι."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five more stones open up, like ones picked up by the stream."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desbloquean cinco piedras más, como recogidas junto al arroyo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viisi kiveä lisää avautuu, kuin ojan varrelta poimittuina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinq autres galets, comme ramassés au bord du ruisseau, se débloquent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lima batu lagi terbuka, seolah dipungut di tepi anak sungai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sbloccano altre cinque pietre, come raccolte in riva al ruscello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "川辺で拾ったような石が、あと5種類使えるようになります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fem steiner til låses opp, som om de var plukket ved bekken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er komen vijf stenen bij, alsof ze langs de beek zijn opgeraapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokuje się jeszcze pięć kamieni, jakby zebranych nad strumykiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais cinco pedras são liberadas, como se fossem colhidas à beira do riacho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откроются ещё пять камней, будто найденных у ручья."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fem stenar till låses upp, som om de plockats vid bäcken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปลดล็อกหินเพิ่มอีกห้าก้อน เหมือนเก็บมาจากริมลำธาร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dere kenarından toplanmış gibi beş taş daha açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở thêm năm viên đá như nhặt bên bờ suối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又会多出五块像是在溪边捡来的石头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又會多出五塊像是在溪邊撿來的石頭。"
