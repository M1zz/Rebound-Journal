            "state": "translated",
            "value": "ZinggumDol Records"
          }
        }
      }
    },
    "징검돌 프로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZinggumDol Pro"
          }
        }
      }
    },
    "징검돌 프로를 쓰고 있어요. 고마워요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're using ZinggumDol Pro. Thank you."
          }
        }
      }
    },
    "짧아도 괜찮아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few words is enough."
          }
        }
      }
    },
    "프로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro"
          }
        }
      }
    },
    "프로로 더 적을래요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll add more with Pro"
          }
        }
      }
    },
    "프로에서 열려요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocks with Pro"
          }
        }
      }
    },
    "한 번 사면 계속 써요. 구독이 아니에요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy once, keep it for good. No subscription"
          }
        }
      }
    },
    "향하는 곳이 여럿이어도 괜찮아요. 개수 제한 없이 적어 둘 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's okay to be heading in more than one direction. Keep as many goals as you need."
          }
        }
      }
    },
    "무료로 쓰던 건 그대로, 몇 가지가 더 열려요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything free stays free. A few more things open up."
          }
        }
      }
    },
    "조약돌의 결을 여섯 가지 중에서 골라요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from six pebble finishes"
          }
        }
      }
    },
    "개울가에서 주운 듯한 돌 다섯 가지가 더 열려요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five more stones open up, like ones picked up by the stream."
          }
        }
      }
    }
  },
  "version": "1.0"
