        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allora, verso «%1$@»%2$@ quale piccola cosa potresti fare già domani?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それじゃあ「%1$@」%2$@ 目指して、\n明日すぐにできるくらい小さなことをひとつ挙げるなら、何だろう？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva er da én liten ting på veien mot «%1$@»%2$@ som du kan klare allerede i morgen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat is dan op weg naar ‘%1$@’%2$@ één klein ding dat je al morgen kunt doen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To co jest na drodze do „%1$@”%2$@ jedną tak małą rzeczą, którą zrobisz już jutro?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
