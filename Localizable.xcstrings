    "그랬구나. 그럼 지금 마음은 좀 어때요?" : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I see. And how are you feeling now?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I see. And how are you feeling now?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这样啊。那现在心情怎么样？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這樣啊。那現在心情怎麼樣？"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そうだったんですね。じゃあ、今の気持ちはどうですか？"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понятно. А как вы себя чувствуете сейчас?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya veo. ¿Y cómo te sientes ahora?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstehe. Und wie fühlst du dich jetzt?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vois. Et comment tu te sens maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisco. E adesso come ti senti?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entendi. E como você está se sentindo agora?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อย่างนี้นี่เอง แล้วตอนนี้รู้สึกยังไงบ้าง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ra vậy. Thế giờ bạn thấy trong lòng thế nào?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chápu. A jak se teď cítíte?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg forstår. Og hvordan har du det nu?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατάλαβα. Και πώς νιώθετε τώρα;"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrän. Miltä sinusta nyt tuntuu?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begitu ya. Lalu, bagaimana perasaan Anda sekarang?"
          }
