    "남겨뒀어요. 통했던 건 잊지 않게요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloženo, ať nezapomeneš, co zabralo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemt, så vi ikke glemmer det, der virkede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert, damit nicht vergessen geht, was geholfen hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύτηκε, για να μη ξεχάσουμε ό,τι δούλεψε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept, so what worked doesn't get forgotten."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept, so what worked doesn't get forgotten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado. Para no olvidar lo que funcionó."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettu, jottei unohdu, mikä auttoi."
          }
