    "이 기기에서는 정리 기능을 쓸 수 없어요. 들린 대로 적어둘게요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidying up isn't available on this device. I'll write it as I heard it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 정리 기능을 쓸 수 없어요. 들린 대로 적어둘게요."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto zařízení není funkce uspořádání dostupná. Zapíšu to tak, jak to slyším."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På denne enhed kan oprydningsfunktionen ikke bruges. Jeg skriver det ned, som jeg hører det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät ist das Ordnen nicht verfügbar. Ich notiere es, wie ich es höre."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε αυτή τη συσκευή η λειτουργία οργάνωσης δεν είναι διαθέσιμη. Θα το σημειώσω όπως το ακούω."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidying up isn't available on this device. I'll write it as I heard it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este dispositivo no se puede usar la función de ordenar. Lo anoto tal como lo oigo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä laitteella jäsennystoimintoa ei voi käyttää. Kirjaan sen ylös sellaisena kuin kuulen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise en forme n’est pas disponible sur cet appareil. Je note tel que j’entends."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di perangkat ini fitur perapian tidak tersedia. Saya catat sesuai yang terdengar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo dispositivo la funzione di riordino non è disponibile. Annoto come sento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは整理機能を使えません。聞こえたとおりに書きとめます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På denne enheten kan ikke ryddefunksjonen brukes. Jeg skriver det ned slik jeg hører det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op dit apparaat is de ordenfunctie niet beschikbaar. Ik schrijf het op zoals ik het hoor."
