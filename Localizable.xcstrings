    "남긴 기록은 그대로 둬요. 목록에서만 빠져요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanechané záznamy zůstanou. Zmizí jen ze seznamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efterladte noter bliver, som de er. Det forsvinder kun fra listen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinterlassene Einträge bleiben erhalten. Nur aus der Liste verschwindet das Ziel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σημειώσεις που αφήσατε μένουν. Αφαιρείται μόνο από τη λίστα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your records stay. It just leaves the list."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your records stay. It just leaves the list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros se conservan. Solo sale de la lista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätetyt merkinnät säilyvät. Vain tavoite poistuu luettelosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes laissées sont conservées. Seul l’objectif disparaît de la liste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan yang ditinggalkan tetap ada. Hanya hilang dari daftar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le note lasciate restano. Esce solo dall’elenco."
