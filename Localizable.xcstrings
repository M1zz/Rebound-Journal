        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในการตั้งค่า คุณเลือกได้ว่าก้อนหินจะพูดสุภาพหรือพูดสบายๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
