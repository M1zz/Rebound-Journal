    "지우면 되돌릴 수 없어요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once it's deleted, it can't be brought back."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지우면 되돌릴 수 없어요."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po smazání už to nejde vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når noget er slettet, kan det ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschtes lässt sich nicht wiederherstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά τη διαγραφή δεν μπορεί να γίνει επαναφορά."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once it's deleted, it can't be brought back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez borrado, no se puede recuperar."
          }
        },
