        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งั้นถ้าจะมุ่งไปที่ “%1$@”%2$@ อะไรคือเรื่องเล็กๆ ที่เธอทำได้ทันทีพรุ่งนี้"
          }
        },
