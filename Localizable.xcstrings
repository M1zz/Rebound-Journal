    "향하는 곳을 아직 못 들었네요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe noch nicht gehört, wohin du unterwegs bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I still haven't heard where you're headed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I still haven't heard where you're headed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no he oído hacia dónde vas."
