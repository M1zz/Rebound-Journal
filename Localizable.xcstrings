    "운동하러 갔다가 중간에 포기하고 왔어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Went to work out and gave up halfway."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동하러 갔다가 중간에 포기하고 왔어요."
          }
        },
        "cs" : {
          "stringUnit" : {
