        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ξέρω ακόμη προς τα πού κατευθύνεστε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I haven't heard what you're heading toward yet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I haven't heard what you're heading toward yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no sé hacia dónde vas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vielä tiedä, mitä kohti olet matkalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne sais pas encore vers quoi vous allez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya belum tahu ke mana Anda menuju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non so ancora verso cosa stai andando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何を目指しているのか、まだ聞いていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇을 향해 가고 있는지 아직 못 들었어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg vet ikke ennå hva du er på vei mot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não sei para onde você está indo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я ещё не знаю, к чему вы идёте."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันยังไม่รู้เลยว่าคุณกำลังมุ่งไปทางไหน"
