        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å, du gjorde det! Jeg skriver det ned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O, het is je gelukt! Ik schrijf het op."
