    "무엇에 닿았고 무엇이 막혔는지, 제가 먼저 보고 말을 걸게요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív se podívám, kam jste se dostali a co vás zastavilo, a pak vás osloví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg ser først på, hvor langt du er nået, og hvad der stod i vejen, og så tager jeg fat i dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich sehe zuerst nach, was du erreicht hast und was dich aufgehalten hat, und spreche dich dann an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα δω πρώτα πού φτάσατε και τι σας εμπόδισε και θα σας μιλήσω εγώ πρώτος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll watch what you reach and what gets stuck, and I'll speak first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll watch what you reach and what gets stuck, and I'll speak first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veré hasta dónde llegaste y qué te frenó, y te hablaré yo primero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katson ensin, mihin pääsit ja mikä tuli vastaan, ja otan sitten puheeksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je regarde d’abord où vous en êtes arrivé et ce qui vous a retenu, puis je vous parle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya akan lihat dulu sampai mana Anda sudah melangkah dan apa yang menghalangi, lalu menyapa Anda lebih dulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarderò io per primo dove sei arrivato e cosa ti ha ostacolato, e poi ti parlerò."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何にたどり着き、何が引っかかったのか、まず私から声をかけますね。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇에 닿았고 무엇이 막혔는지, 제가 먼저 보고 말을 걸게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg ser først på hvor langt du har kommet og hva som sto i veien, og så tar jeg kontakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vou ver até onde você chegou e o que travou, e puxo a conversa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я сам загляну, до чего вы дошли и что вас остановило, и начну разговор."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันจะดูก่อนว่าคุณไปถึงไหนและติดขัดตรงไหน แล้วจะเข้าไปคุยด้วย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mình sẽ xem bạn đã đi tới đâu và điều gì vướng, rồi chủ động bắt chuyện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我会留意你走到了哪里、被什么卡住了，并主动和你说话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我會留意你走到了哪裡、被什麼卡住了，並主動和你說話。"
          }
        }
      }
    },
    "무엇을 향해 가고 있는지 아직 못 들었어요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím nevím, kam směřujete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg ved endnu ikke, hvad du er på vej mod."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich weiß noch nicht, worauf du zusteuerst."
