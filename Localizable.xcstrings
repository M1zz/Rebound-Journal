          "stringUnit" : {
            "state" : "translated",
            "value" : "О, получилось! Запишу, что сделано."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Oh, lo hiciste! Lo anoto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oh, du hast es gemacht! Ich notiere das."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oh, tu l’as fait ! Je le note."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oh, l’hai fatto! Lo annoto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ah, você fez! Vou anotar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โอ้ ทำแล้วนี่! จะจดไว้ว่าทำแล้วนะ"
