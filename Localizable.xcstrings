    "무슨 일이 있었나요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What happened"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
