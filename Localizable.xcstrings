    "설정에서 Apple Intelligence를 켜면 말한 내용을 더 잘 정리해 드려요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning on Apple Intelligence in Settings helps me tidy up what you say."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 Apple Intelligence를 켜면 말한 내용을 더 잘 정리해 드려요."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte v „Nastavení“ Apple Intelligence a řečené dokážu lépe uspořádat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Apple Intelligence til i „Indstillinger“, så kan jeg bedre samle op på det, du siger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte in den „Einstellungen“ Apple Intelligence ein, dann kann ich das Gesagte besser ordnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε το Apple Intelligence στις «Ρυθμίσεις» και θα μπορώ να οργανώνω καλύτερα όσα λέτε."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning on Apple Intelligence in Settings helps me tidy up what you say."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Apple Intelligence en «Ajustes» y podré ordenar mejor lo que dices."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota Apple Intelligence käyttöön kohdassa ”Asetukset”, niin osaan jäsentää sanomasi paremmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Apple Intelligence dans « Réglages » et je pourrai mieux mettre en forme ce que vous dites."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan Apple Intelligence di «Pengaturan» agar saya bisa merapikan ucapan Anda dengan lebih baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Apple Intelligence in «Impostazioni» e potrò riordinare meglio ciò che dici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」でApple Intelligenceをオンにすると、話した内容をより上手に整理できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Apple Intelligence i «Innstillinger», så kan jeg rydde bedre i det du sier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet Apple Intelligence aan in ‘Instellingen’, dan kan ik wat u zegt beter ordenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz Apple Intelligence w „Ustawieniach”, a lepiej uporządkuję to, co mówisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a Apple Intelligence em «Ajustes» e consigo organizar melhor o que você diz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите Apple Intelligence в «Настройках» — и я смогу лучше упорядочивать сказанное."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera Apple Intelligence i ”Inställningar” så kan jag ordna det du säger bättre."
