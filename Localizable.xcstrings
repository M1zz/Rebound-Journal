    "나머지는 서두르지 않아도 돼요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den Rest musst du dich nicht beeilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to hurry the rest."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to hurry the rest."
          }
        },
