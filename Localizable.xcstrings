    "언제든 다시 바꿀 수 있어요. 바꾸면 조약돌이 그 말투로 다시 인사해요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change it anytime. The pebble will greet you again in that tone."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언제든 다시 바꿀 수 있어요. 바꾸면 조약돌이 그 말투로 다시 인사해요."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdykoli to můžete změnit. Po změně vás oblázek znovu pozdraví novým způsobem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan altid ændre det. Når du gør, hilser stenen på dig igen på den måde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das jederzeit ändern. Danach begrüßt dich der Kiesel in der neuen Anrede."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να το αλλάξετε οποιαδήποτε στιγμή. Μετά την αλλαγή, το βότσαλο θα σας χαιρετήσει ξανά με αυτόν τον τρόπο."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change it anytime. The pebble will greet you again in that tone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiarlo cuando quieras. Al cambiarlo, el guijarro te saludará de nuevo con ese trato."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit vaihtaa tämän milloin tahansa. Vaihdon jälkeen kivi tervehtii sinua uudelleen uudella tavalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez le changer à tout moment. Ensuite, le galet vous saluera à nouveau avec ce ton."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda bisa mengubahnya kapan saja. Setelah diubah, kerikil akan menyapa Anda lagi dengan gaya itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi cambiarlo quando vuoi. Poi il sassolino ti saluterà di nuovo con quel tono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつでも変えられます。変えると、小石がその話し方でもう一度あいさつします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan endre det når som helst. Når du gjør det, hilser steinen på deg igjen på den måten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U kunt dit altijd wijzigen. Daarna begroet de kiezel u opnieuw op die manier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz to zmienić w każdej chwili. Po zmianie kamyk przywita Cię ponownie w nowy sposób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode mudar quando quiser. Ao mudar, a pedrinha cumprimenta você de novo nesse tom."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это можно изменить в любой момент. Камешек поприветствует вас уже в новом стиле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ändra det när som helst. Efter ändringen hälsar stenen på dig igen på det sättet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนได้ทุกเมื่อ เมื่อเปลี่ยนแล้ว ก้อนหินจะทักทายอีกครั้งด้วยน้ำเสียงนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğiniz zaman değiştirebilirsiniz. Değiştirince çakıl taşı sizi yeniden bu hitapla selamlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể đổi bất cứ lúc nào. Đổi xong, viên đá sẽ chào lại bạn bằng giọng điệu mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时更改。更改后，小石子会用新的语气重新跟你打招呼。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以隨時更改。更改後，小石子會用新的語氣重新跟你打招呼。"
          }
        }
      }
    },
    "얼마 전" : {
      "localizations" : {
