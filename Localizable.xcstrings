        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay dừng ở đây thôi.\nLúc này nghỉ ngơi quan trọng hơn tìm câu trả lời.\nĐã ghi lại rồi, sẽ không mất đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
