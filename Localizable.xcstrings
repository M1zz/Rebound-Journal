    "그럴 수 있어요. 잊었다고 없어지는 건 아니니까요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To se stává. Že jste na to zapomněli, neznamená, že to zmizelo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan ske. At glemme betyder ikke, at det forsvinder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kann passieren. Vergessen heißt nicht, dass es verschwindet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμβαίνει. Το ότι το ξεχάσατε δεν σημαίνει ότι χάθηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That happens. Forgetting doesn't erase it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That happens. Forgetting doesn't erase it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede pasar. Que se olvide no significa que desaparezca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niin voi käydä. Unohtaminen ei tee asiasta olematonta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça arrive. Oublier ne fait pas disparaître les choses."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itu wajar. Melupakan bukan berarti masalahnya hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può capitare. Dimenticare non fa sparire le cose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そういうこともあります。忘れたからといって、なくなるわけではないですから。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그럴 수 있어요. 잊었다고 없어지는 건 아니니까요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan skje. Å glemme betyr ikke at det forsvinner."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode acontecer. Esquecer não faz as coisas sumirem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бывает. Забытое не исчезает само по себе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นเรื่องปกติ ลืมไปไม่ได้แปลว่าเรื่องนั้นหายไป"
          }
        },
        "vi" : {
          "stringUnit" : {
