        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, teit sen! Kirjaan sen ylös."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oh, berhasil! Saya catat sudah dilakukan."
