    },
    "\"%@\"": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\""
          }
        }
      }
    },
    "\"11시에 배가 고팠다. 냉장고를 열었다. 치킨을 먹었다.\"": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"At 11 pm I got hungry. I opened the fridge. I ate fried chicken.\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"11시에 배가 고팠다. 냉장고를 열었다. 치킨을 먹었다.\""
          }
        }
      }
    },
    "\"~할 때, ~하겠다\" 형식으로 계획을 세워보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a plan shaped like \"When X happens, I will Y\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"~할 때, ~하겠다\" 형식으로 계획을 세워보세요"
          }
        }
      }
    },
    "\"물 마시기\", \"산책하기\", \"친구에게 전화하기\"": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Drink water\", \"Take a walk\", \"Call a friend\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"물 마시기\", \"산책하기\", \"친구에게 전화하기\""
          }
        }
      }
    },
    "\"배고플 때, 먼저 물 한 잔을 마시겠다\"\n\"야식 생각이 날 때, 양치질을 하겠다\"": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"When I get hungry, I will drink a glass of water first\"\n\"When I crave a late-night snack, I will brush my teeth\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"배고플 때, 먼저 물 한 잔을 마시겠다\"\n\"야식 생각이 날 때, 양치질을 하겠다\""
          }
        }
      }
    },
    "\"오늘 하루만 괜찮겠지\", \"내일부터 하면 돼\"": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Just for today\", \"I will start tomorrow\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"오늘 하루만 괜찮겠지\", \"내일부터 하면 돼\""
          }
        }
      }
    },
    "%@\n막힌 건 '%@'였고,\n지금 기분은 '%@'%@.\n\n%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nWhat got in the way was '%2$@',\nand right now you feel '%3$@'%4$@.\n\n%5$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n막힌 건 '%2$@'였고,\n지금 기분은 '%3$@'%4$@.\n\n%5$@"
          }
        }
      }
    },
    "%@ '%@' 얘기하면서 '%@'라고 남겼지.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, while talking about '%2$@', you wrote '%3$@'."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ '%2$@' 얘기하면서 '%3$@'라고 남겼지."
          }
        }
      }
    },
