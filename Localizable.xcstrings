        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 향하고 있는 게 있으면 하나만 들려주실래요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você está indo em direção a algo, me conta uma coisa?"
