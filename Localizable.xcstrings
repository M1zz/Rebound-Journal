    },
    "향하는 곳이 여럿이어도 괜찮아요. 개수 제한 없이 적어 둘 수 있어요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist in Ordnung, mehrere Ziele zu haben. Du kannst sie ohne Limit notieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's okay to be heading in more than one direction. Keep as many goals as you need."
