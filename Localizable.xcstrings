    },
    "그때 무슨 생각을 했나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What went through your mind?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그때 무슨 생각을 했나요?"
          }
        }
      }
    },
    "그래서 그 슛을 다시 쏘고난 지금 기분은 어때요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now that you have taken the shot again, how do you feel?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래서 그 슛을 다시 쏘고난 지금 기분은 어때요?"
          }
        }
      }
    },
    "그래서 이 다음은 어떻게 되는거에요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So what comes next?"
          }
