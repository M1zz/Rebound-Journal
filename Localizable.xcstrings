        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그럼 이건 어때요. 내일 바로 해낼 수 있을 만큼 작게 만든다면, 뭐가 될까요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que tal assim: se você deixasse isso pequeno o bastante para fazer amanhã mesmo, o que seria?"
