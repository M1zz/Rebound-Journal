          "stringUnit" : {
            "state" : "translated",
            "value" : "Ồ, bạn làm rồi! Mình sẽ ghi là đã làm nhé."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ó, povedlo se! Zapíšu si to."
