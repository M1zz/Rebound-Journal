    "설정에서 Apple Intelligence를 켜면 말한 내용을 더 잘 정리해 드려요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte in den „Einstellungen“ Apple Intelligence ein, dann kann ich das Gesagte besser ordnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning on Apple Intelligence in Settings helps me tidy up what you say."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning on Apple Intelligence in Settings helps me tidy up what you say."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Apple Intelligence en «Ajustes» y podré ordenar mejor lo que dices."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Apple Intelligence dans « Réglages » et je pourrai mieux mettre en forme ce que vous dites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Apple Intelligence in «Impostazioni» e potrò riordinare meglio ciò che dici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」でApple Intelligenceをオンにすると、話した内容をより上手に整理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 Apple Intelligence를 켜면 말한 내용을 더 잘 정리해 드려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a Apple Intelligence em «Ajustes» e consigo organizar melhor o que você diz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите Apple Intelligence в «Настройках» — и я смогу лучше упорядочивать сказанное."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「设置」中打开 Apple 智能，我就能更好地整理你说的话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定」中開啟 Apple Intelligence，我就能更好地整理你說的話。"
          }
        }
      }
    },
