    "해보려는 게 여럿이어도 괜찮아요. 개수 제한 없이 적어 둘 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Working on several things? Write down as many as you like."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Working on several things? Write down as many as you like."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想尝试的事有好几件也没关系，可以不限数量地写下来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
