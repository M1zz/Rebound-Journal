    "그럴 수 있어요. 잊었다고 없어지는 건 아니니까요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kann passieren. Vergessen heißt nicht, dass es verschwindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That happens. Forgetting doesn't erase it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That happens. Forgetting doesn't erase it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede pasar. Que se olvide no significa que desaparezca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça arrive. Oublier ne fait pas disparaître les choses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そういうこともあります。忘れたからといって、なくなるわけではないですから。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그럴 수 있어요. 잊었다고 없어지는 건 아니니까요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бывает. Забытое не исчезает само по себе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这很正常。忘记了，事情也不会因此消失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這很正常。忘記了，事情也不會因此消失。"
          }
        }
      }
    },
    "그럴 수 있죠. 잊은 건 잊은 거고요." : {
