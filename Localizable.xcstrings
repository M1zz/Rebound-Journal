    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: large text layouts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you make text bigger, screens rearrange neatly and nothing gets cut off."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you make text bigger, screens rearrange neatly and nothing gets cut off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大文字也不会被截断，界面会重新排列得清清楚楚。"
