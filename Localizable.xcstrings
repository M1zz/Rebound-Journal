    "지금 향하고 있는 게 있으면 하나만 들려주실래요?" : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du gerade auf etwas zusteuerst, erzählst du mir von einer Sache?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If there's something you're heading toward, will you tell me one?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If there's something you're heading toward, will you tell me one?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si hay algo hacia lo que vayas ahora, ¿me cuentas una cosa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’il y a quelque chose vers quoi vous allez, pouvez-vous m’en parler ?"
