    "떠오르지 않으면 비워둬도 돼요. 나중에 같이 찾아요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fällt dir nichts ein, lass es leer. Wir suchen später gemeinsam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If nothing comes to mind, leave it blank. We'll find it later."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If nothing comes to mind, leave it blank. We'll find it later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no se te ocurre nada, puedes dejarlo en blanco. Lo buscamos luego juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rien ne vient, vous pouvez laisser vide. On cherchera ensemble plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non ti viene in mente niente, puoi lasciarlo vuoto. Lo cerchiamo insieme più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "思い浮かばなければ空欄でも大丈夫。あとで一緒に探しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "떠오르지 않으면 비워둬도 돼요. 나중에 같이 찾아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se não vier nada à cabeça, pode deixar em branco. Procuramos juntos depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ничего не приходит в голову, можно оставить пустым. Найдём позже вместе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想不起来就留空吧，以后我们一起找。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想不起來就留空吧，以後我們一起找。"
          }
        }
      }
    },
