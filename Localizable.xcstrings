{
  "sourceLanguage": "ko",
  "strings": {
    "%@\n막힌 건 '%@'였고,\n지금 기분은 '%@'%@.\n\n%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nWhat got in the way was '%2$@',\nand right now you feel '%3$@'%4$@.\n\n%5$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n막힌 건 '%2$@'였고,\n지금 기분은 '%3$@'%4$@.\n\n%5$@"
          }
        }
      }
    },
    "%@ '%@' 얘기하면서 '%@'라고 남겼지.": {
