    "나머지는 서두르지 않아도 돼요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den Rest musst du dich nicht beeilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to hurry the rest."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to hurry the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo demás no corre prisa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le reste n’est pas pressé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per il resto non c’è fretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残りは急がなくて大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나머지는 서두르지 않아도 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O resto não tem pressa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С остальным можно не спешить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其余的不用着急。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其餘的不用著急。"
          }
        }
      }
    },
    "나머지는 접어두고 이것만 봐요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Rest klappen wir zu und sehen uns nur das an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the rest aside and look at this one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the rest aside and look at this one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardemos lo demás y miremos solo esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On met le reste de côté et on ne regarde que ça."
