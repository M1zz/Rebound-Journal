    "밀거나 길게 누르면 이름을 고치거나 내려놓을 수 있어요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe or long-press a goal to rename it or set it down."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejetím nebo dlouhým stisknutím cíle ho můžete přejmenovat nebo pustit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg eller hold nede på et mål for at omdøbe det eller slippe det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische oder halte ein Ziel gedrückt, um es umzubenennen oder loszulassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε ή πατήστε παρατεταμένα έναν στόχο για να τον μετονομάσετε ή να τον αφήσετε."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe or long-press a goal to rename it or set it down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza o mantén pulsada una meta para cambiarle el nombre o soltarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyhkäise tai paina pitkään tavoitetta nimetäksesi sen uudelleen tai päästääksesi siitä irti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser ou appuyez longuement sur un objectif pour le renommer ou le lâcher."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser atau tekan lama sebuah tujuan untuk mengganti nama atau melepasnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri o tieni premuto un obiettivo per rinominarlo o lasciarlo andare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スワイプまたは長押しで、名前を変えたり手放したりできます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip eller hold inne på et mål for å gi det nytt navn eller slippe det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg of houd een doel ingedrukt om het een andere naam te geven of los te laten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń lub przytrzymaj cel, aby zmienić jego nazwę lub go odpuścić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize ou mantenha pressionada uma meta para renomear ou soltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
