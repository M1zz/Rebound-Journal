    "여기까지만 해요.\n지친 날에 세운 계획은 잘 안 되더라고요.\n남겨뒀으니 괜찮아요." : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro dnešek dost.\nPlány z unavených dnů málokdy vyjdou.\nUložilo se to, nic se neděje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad os stoppe her for i dag.\nPlaner, man lægger på trætte dage, holder sjældent.\nDet er gemt, så det er helt i orden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für heute reicht es.\nPläne, die man an müden Tagen macht, gehen selten auf.\nEs ist gespeichert, alles gut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ας σταματήσουμε εδώ για σήμερα.\nΤα σχέδια που φτιάχνονται τις κουρασμένες μέρες σπάνια πετυχαίνουν.\nΈχει αποθηκευτεί, δεν πειράζει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is far enough.\nPlans made on a tired day rarely hold.\nIt's kept, so it's fine."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is far enough.\nPlans made on a tired day rarely hold.\nIt's kept, so it's fine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejémoslo aquí por hoy.\nLos planes hechos en días de cansancio suelen no salir bien.\nYa quedó guardado, tranquilo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopetetaan tältä päivältä.\nUupuneina päivinä tehdyt suunnitelmat harvoin pitävät.\nSe on tallessa, ei hätää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On s’arrête là pour aujourd’hui.\nLes plans faits un jour de fatigue marchent rarement.\nC’est gardé, ne vous inquiétez pas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cukup sampai di sini untuk hari ini.\nRencana yang dibuat di hari yang melelahkan sering tidak berjalan.\nSudah tersimpan, tidak apa-apa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermiamoci qui per oggi.\nI piani fatti nei giorni di stanchezza di solito non funzionano.\nÈ salvato, tranquillo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はここまでにしましょう。\n疲れた日に立てた計画は、うまくいかないものです。\n残してあるので大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기까지만 해요.\n지친 날에 세운 계획은 잘 안 되더라고요.\n남겨뒀으니 괜찮아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La oss stoppe her for i dag.\nPlaner man legger på slitne dager, holder sjelden.\nDet er lagret, så det går bra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por hoje é só.\nPlanos feitos em dias cansados costumam não dar certo.\nJá está guardado, fique tranquilo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На сегодня хватит.\nПланы, составленные в усталые дни, редко получаются.\nЗапись сохранена, всё в порядке."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้พอแค่นี้นะ\nแผนที่วางไว้ในวันที่เหนื่อยมักไม่ค่อยเป็นไปตามนั้น\nจดไว้แล้ว ไม่เป็นไรนะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay dừng ở đây thôi.\nKế hoạch lập vào ngày mệt mỏi thường khó thành.\nĐã lưu lại rồi, không sao đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天就到这里。\n心累的日子定的计划，往往很难坚持。\n已经留下了，没关系。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天就到這裡。\n心累的日子定的計劃，往往很難堅持。\n已經留下了，沒關係。"
          }
        }
      }
    },
    "여기까진 무슨 일이 있었는지였고요. 지금 마음은 어때요?" : {
      "comment" : "조약돌 문구 — Phrasing.say/pick 이 실행 중에 찾는다",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosud šlo o to, co se stalo. A jak je vám teď u srdce?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtil nu handlede det om, hvad der skete. Hvordan har du det inderst inde nu?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis hier ging es darum, was passiert ist. Wie fühlst du dich jetzt?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μέχρι εδώ ήταν το τι έγινε. Και πώς νιώθετε τώρα;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That was what happened. How about how you feel?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That was what happened. How about how you feel?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso fue lo que pasó. ¿Cómo te sientes ahora?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tähän asti puhuttiin siitä, mitä tapahtui. Miltä sinusta tuntuu nyt?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’ici, c’était ce qui s’est passé. Et que ressentez-vous maintenant ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sampai di sini adalah soal apa yang terjadi. Bagaimana perasaan Anda sekarang?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fin qui era ciò che è successo. E ora come ti senti?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここまでは何があったかの話でした。今の気持ちはどうですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기까진 무슨 일이 있었는지였고요. 지금 마음은 어때요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frem til nå handlet det om hva som skjedde. Hvordan har du det inni deg nå?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até aqui foi o que aconteceu. E como está o seu coração agora?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это было о том, что случилось. А что у вас на душе сейчас?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่ผ่านมาคือเรื่องที่เกิดขึ้น แล้วตอนนี้ในใจรู้สึกยังไง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tới đây là chuyện đã xảy ra. Còn bây giờ trong lòng bạn thế nào?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刚才说的是发生了什么。现在心里是什么感觉？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剛才說的是發生了什麼。現在心裡是什麼感覺？"
          }
        }
      }
    },
