    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon wird verwendet, damit du den Tag ganz einfach per Sprache Revue passieren lassen kannst. Aufnahmen werden nicht gespeichert; auf deinem Gerät bleibt nur der transkribierte Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone lets you look back out loud. Recordings are never saved, only the text stays on your device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone lets you look back out loud. Recordings are never saved, only the text stays on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa el micrófono para que puedas repasar tu día hablando, como en una conversación. Las grabaciones no se guardan; en tu dispositivo solo queda el texto transcrito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話のように気軽に振り返れるよう、マイクを使います。録音は保存されず、文字に起こしたテキストだけがデバイスに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말로 편하게 돌아볼 수 있도록 마이크를 사용해요. 녹음은 저장되지 않고, 글로 옮긴 내용만 기기 안에 남습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон нужен, чтобы вы могли вспоминать день голосом, как в разговоре. Записи не сохраняются — на устройстве остаётся только распознанный текст."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用麦克风,是为了让你可以轻松地用说话的方式回顾。录音不会被保存,只有转写出的文字会留在你的设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用麥克風,是為了讓你可以輕鬆地用說話的方式回顧。錄音不會被儲存,只有轉寫出的文字會留在你的裝置上。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um Gesprochenes in Text umzuwandeln. Die Erkennung erfolgt auf deinem Gerät und verlässt es nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to turn what you say into text. Recognition happens on your device and never leaves it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to turn what you say into text. Recognition happens on your device and never leaves it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para convertir en texto lo que dices. El reconocimiento se hace en tu dispositivo y no sale de él."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話した内容を文字に変換するために使います。認識はデバイス上で行われ、外部には送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말한 내용을 글로 옮기기 위해 사용해요. 인식은 기기 안에서 이뤄지고 밖으로 나가지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно для преобразования сказанного в текст. Распознавание выполняется на устройстве и не передаётся наружу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于把你说的话转成文字。识别在你的设备上完成,不会传到设备之外。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於把你說的話轉成文字。辨識在你的裝置上完成,不會傳到裝置之外。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}